#version 460
#extension GL_GOOGLE_include_directive : enable
#include "../include/common.glsl"

layout(local_size_x = 256) in;

// Closest a particle centre may get to a wall, in metres.
#define WALL_SAFETY_MARGIN 0.005



layout(std430, set = 0, binding = 0) readonly buffer Positions { vec4 positions[]; };
layout(std430, set = 0, binding = 1) readonly buffer PressureForces { vec4 pressure_forces[]; };

layout(std430, set = 0, binding = 3) buffer Velosities { vec4 velocities[]; };
layout(std430, set = 0, binding = 4) buffer NewPosBuffer { vec4 new_positions[]; };
layout(std430, set = 0, binding = 5) readonly buffer Pressures { float pressures[]; };
layout(std430, set = 0, binding = 6) buffer WarmStart { vec2 warm_start[]; };


void main() {
    uint i = gl_GlobalInvocationID.x;
    uint num_particles = uint(positions.length());

    if (i >= num_particles) return;

    float dt = sim_params.dt;

    vec3 pos = positions[i].xyz;
    vec3 vel = velocities[i].xyz;

    vec3 ap = pressure_forces[i].xyz;

    vec3 new_vel = vel + ap * dt;
    vec3 new_pos = pos + new_vel * dt;

    // The walls push particles away through the pressure solve (box_boundary
    // in common.glsl), so this is only a safety net against leaving the box:
    // it puts a particle back on the wall and removes the velocity component
    // into the wall, without bouncing it back into the fluid.
    vec3 min_b = sim_params.box_min.xyz + vec3(WALL_SAFETY_MARGIN);
    vec3 max_b = sim_params.box_max.xyz - vec3(WALL_SAFETY_MARGIN);
    vec3 wall_velocity_min = vec3(sim_params.piston_velocity, 0.0, 0.0);
    for (int axis = 0; axis < 3; axis++) {
        if (new_pos[axis] < min_b[axis]) {
            new_pos[axis] = min_b[axis];
            new_vel[axis] = max(new_vel[axis], wall_velocity_min[axis]);
        } else if (new_pos[axis] > max_b[axis]) {
            new_pos[axis] = max_b[axis];
            new_vel[axis] = min(new_vel[axis], 0.0);
        }
    }

    // Same safety net for the pillar: push the particle back onto its surface
    // and drop the velocity component pointing into it.
    float to_pillar;
    vec3 pillar_normal;
    if (pillar_distance(new_pos, to_pillar, pillar_normal) && to_pillar < WALL_SAFETY_MARGIN) {
        new_pos += (WALL_SAFETY_MARGIN - to_pillar) * pillar_normal;
        new_vel -= min(dot(new_vel, pillar_normal), 0.0) * pillar_normal;
    }

    warm_start[i].x = pressures[i] * dt * dt;
    new_positions[i] = vec4(new_pos, 1.0);
    velocities[i] = vec4(new_vel, 0.0);
}