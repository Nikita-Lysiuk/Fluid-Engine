#version 460
#extension GL_GOOGLE_include_directive : enable
#include "../include/common.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer Velocities { vec4 velocities[]; };
// [0]: max speed as float bits (non-negative floats order like uints)
layout(std430, set = 0, binding = 1) buffer StatsBuffer { uint max_speed_bits; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(velocities.length())) return;

    float speed = length(velocities[i].xyz);
    atomicMax(max_speed_bits, floatBitsToUint(speed));
}
