#version 460
#extension GL_GOOGLE_include_directive : enable
#include "../include/common.glsl"

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer NeighborList { uint neighbor_list[]; };
layout(std430, set = 0, binding = 1) readonly buffer NeighborCounts { uint neighbor_counts[]; };
layout(std430, set = 0, binding = 3) readonly buffer Positions { vec4 positions[]; };
layout(std430, set = 0, binding = 4) readonly buffer Densities { float densities[]; };
layout(std430, set = 0, binding = 5) readonly buffer NewVelocities { vec4 new_velocities[]; };

layout(std430, set = 0, binding = 6) buffer Pressures { float pressures[]; };
layout(std430, set = 0, binding = 7) buffer SourceTerms { float source_terms[]; };
layout(std430, set = 0, binding = 8) readonly buffer WarmStart { vec2 warm_start[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint num_particles = uint(positions.length());

    if (i >= num_particles) return;

    vec3 pos_i = positions[i].xyz;
    float rho_i = densities[i];
    vec3 vel_i = new_velocities[i].xyz;
    float h = sim_params.smoothing_radius;
    float mass = sim_params.particle_mass;
    float dt = sim_params.dt;


    float divergence_sum = 0.0;

    uint neighbor_count = neighbor_counts[i];
    for (uint k = 0u; k < neighbor_count; k++) {
        uint j = neighbor_list[k * num_particles + i];

        vec3 pos_j = positions[j].xyz;
        vec3 r_vec = pos_i - pos_j;
        float r2 = dot(r_vec, r_vec);

        if (r2 > h * h) continue;

        float r = sqrt(r2);

        if (r > 1e-6) {
            vec3 grad = kernel_grad(r_vec, r, h);
            vec3 vel_j = new_velocities[j].xyz;
            vec3 vel_diff = vel_i - vel_j;
            divergence_sum += mass * dot(vel_diff, grad);
        }
        }

    float rho_0 = sim_params.target_density;
    divergence_sum += rho_0 * box_boundary_divergence(pos_i, vel_i);

    float source = 0.0;
    if (dt > 1e-6) {
        source = ((rho_0 - rho_i) / dt) - divergence_sum;
        // Only compression is corrected (SPlisHSPlasH: densityAdv = max(densityAdv, 1)).
        source = min(source, 0.0);
    }

    source_terms[i] = source;

    float p0 = 0.0;
    if (source < 0.0 && dt > 1e-6) {
        float cap = WARM_START_CAP_DENSITY * rho_i * rho_i;
        p0 = 0.5 * min(warm_start[i].x, cap) / (dt * dt);
    }
    pressures[i] = p0;
}